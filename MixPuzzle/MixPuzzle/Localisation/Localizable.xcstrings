    "mix.inversion.step1.text" : {
      "comment" : "Lesson step 1 text: count and list of pairs",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pair of tiles where the bigger number stands before the smaller one. Read the board row by row: there are %lld such pairs here: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пара плиток, где большее число стоит раньше меньшего. Прочитаем поле по строкам: таких пар здесь %lld — %@."
          }
        }
      }
    },
    "mix.inversion.step1.title" : {
      "comment" : "Lesson step 1 title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is an inversion"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что такое инверсия"
          }
        }
      }
    },
    "mix.inversion.step2.text" : {
      "comment" : "Lesson step 2 text with inversion count",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiles are written in a row: the first line left to right, the second right to left, and so on. This works for boards of any size. Read like this, the board has %lld inversions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плитки выписываются в строку: первая строка слева направо, вторая справа налево и так далее. Так счёт работает для полей любого размера. При таком чтении инверсий %lld."
          }
        }
      }
    },
    "mix.inversion.step2.title" : {
      "comment" : "Lesson step 2 title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the board like a snake"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читаем поле змейкой"
          }
        }
      }
    },
    "mix.inversion.step3.text" : {
      "comment" : "Lesson step 3 text",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving the blank cell does not change the parity of inversions. Swapping two tiles does. Try both buttons."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвиг пустой клетки не меняет чётность инверсий. Обмен двух плиток — меняет. Попробуйте обе кнопки."
          }
        }
      }
    },
    "mix.inversion.step3.title" : {
      "comment" : "Lesson step 3 title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What changes the parity"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что меняет чётность"
          }
        }
      }
    },
    "mix.inversion.step4.text" : {
      "comment" : "Lesson step 4 text",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count the parity of your arrangement and of the target. If they match, there is a solution. If not, no moves will reach the target."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считаем чётность у вашей расстановки и у цели. Совпала — решение есть. Разная — до цели не дойти никакими ходами."
          }
        }
      }
    },
    "mix.inversion.step4.title" : {
      "comment" : "Lesson step 4 title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare with the target"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
