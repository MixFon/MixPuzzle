{
  "sourceLanguage" : "en",
  "strings" : {
    "  - ✅ Pairs match → solution exists" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  - ✅ Четности совпадают → решение существует"
          }
        }
      }
    },
    "  - ❌ Equalities different → solution impossible" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  - ❌ Четности разные → решение невозможно"
          }
        }
      }
    },
    "?" : {
      "comment" : "A placeholder text for an empty puzzle tile.",
      "isCommentAutoGenerated" : true
    },
    "**Inversion** is the number of pairs of elements that are in front of elements that have less importance than themselves." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Инверсия** — количество пар элементов, которые стоят перед элементами, имеющими меньшее значение, чем они сами."
          }
        }
      }
    },
